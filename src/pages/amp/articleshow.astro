---
import AMPLayout from "../../layouts/amp/Layout.astro";

const values =  Astro.url.searchParams
const msid = values.get("id");
const articleData = await fetch(`https://api.etnownews.com/request/articleshow?origin=amp&msid=${msid}&channel_id=382`);
const app = await articleData.json();

---
<AMPLayout app={app} usedTags={['amp-analytics', 'amp-iframe', "amp-geo"]} />
