---
import MainLayout from "../layouts/MainLayout.astro";

const values =  Astro.url.searchParams
const msid = values.get("id");
const isMobileView = values.get("isMobileView");

const articleData = await fetch(`https://api.etnownews.com/request/articleshow?origin=${isMobileView === "true" ? "mobile" : "desktop"}&msid=${msid}&channel_id=382`);
const articleDataJson = await articleData.json();
---

<MainLayout articleDataJson={articleDataJson} />