---
import Popup from "@components/common/popup/Popup.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Search from "@components/common/search/Search.astro";

const values =  Astro.url.searchParams
const msid = values.get("id");
const isMobileView = values.get("isMobileView");

const articleData = await fetch(`https://api.etnownews.com/request/articleshow?origin=${isMobileView === "true" ? "mobile" : "desktop"}&msid=${msid}&channel_id=382`);
const app = await articleData.json();

---

<MainLayout app={app} />
<Popup instanceId="mobileSearchPopup">
    <Search instanceId="mobile"/>
</Popup>

