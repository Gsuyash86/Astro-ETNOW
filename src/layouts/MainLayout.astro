---
const values = Astro.locals;
const {isMobileView, isPrimeUser, isAppView, requestDomain, akamaiHeader, akamaiHeaderCountryCode, isGlance } = values;
import MobileLayout from "./mobile/Layout.astro";
import DesktopLayout from "./desktop/Layout.astro";
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
            {isMobileView ? <MobileLayout /> : <DesktopLayout />}
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
