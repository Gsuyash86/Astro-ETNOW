---
import "@styles/global.scss";
import MobileLayout from "./mobile/Layout.astro";
import DesktopLayout from "./desktop/Layout.astro";
import _get from "lodash/get";

const values =  Astro.url.searchParams
const articleDataJson = Astro.props.articleDataJson;
const isMobileView = values.get("isMobileView");

const pageTarget = {
  category: values.get("category"),
  subCategory: values.get("subCategory"),
  subSubCategory: values.get("subSubCategory"),
  articleType: values.get("articleType"),
  id: values.get("id"),
}

---

<Fragment slot={"head"}>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:wght@400;700&family=Inter:wght@400;700&display=swap"
  />

  <meta name="generator" content={Astro.generator} />
  <title>Astro Basics</title>
  <script is:inline>
    !(function (a9, a, p, s, t, A, g) {
      if (a[a9]) return;
      function q(c, r) {
        a[a9]._Q.push([c, r]);
      }
      a[a9] = {
        init: function () {
          q("i", arguments);
        },
        fetchBids: function () {
          q("f", arguments);
        },
        setDisplayBids: function () {},
        targetingKeys: function () {
          return [];
        },
        _Q: [],
      };
      A = p.createElement(s);
      A.async = !0;
      A.defer = !0;
      A.src = t;
      g = p.getElementsByTagName(s)[0];
      g.parentNode.insertBefore(A, g);
    })(
      "apstag",
      window,
      document,
      "script",
      "//c.amazon-adsystem.com/aax2/apstag.js",
    );
  </script>
  <script id="dpfscript" src="/dfpamzn.js" type="text/javascript" defer
  ></script>
  <script>
    import { checkScriptLoad } from "../scripts/onetap.js";
    document.addEventListener("DOMContentLoaded", () => {
      checkScriptLoad();
    });
  </script>
</Fragment>

<body>
  {isMobileView === "true" ? <MobileLayout /> : <DesktopLayout ads = {_get(articleDataJson, "response.ads", {})} pageTarget={pageTarget}/>}
</body>
