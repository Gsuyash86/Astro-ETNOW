---
import StaticMetaLinks from "@components/common/seo/staticMetaLinks/StaticMetaLinks.astro";
import DynamicMetaLinks from "@components/common/seo/dynamicMetaLinks/DynamicMetaLinks.astro";
import _get from "lodash/get";
import {
  getCustomDimensionsSSR,
  ampGA4,
  removeHtmlTags,
  NOT_FOUND_META_DETAIL,
  PUBMATIC_PUB_ID_AMP,
  PUBMATIC_PROFILE_ID_AMP,
  generateAmpScripts,
} from "@utils/common";
import serverConfig from "src/scripts/serverConfig";
import dataConfig from "./dataConfig";

const values = Astro.url.searchParams;
const { app, cdpCookies = {}, status, usedTags = [] } = Astro.props;
const ampScripts = generateAmpScripts(usedTags);

const pageTarget = {
  category: values.get("category"),
  subCategory: values.get("subCategory"),
  subSubCategory: values.get("subSubCategory"),
  articleType: values.get("articleType"),
  id: values.get("id"),
};
const seoData = _get(app, "response.sections.article_show.data.[0].seo", {});
const customDimension: any = getCustomDimensionsSSR(app, pageTarget, seoData);
const eventScriptGA4 = ampGA4(serverConfig.analytics.ga4TrackingId);
const createdBy = customDimension?.GA4CustomDimensions?.authors;
const sectionData = customDimension?.GA4CustomDimensions?.section;
const ampStyle = `<style amp-custom>
  body {
        -webkit-animation: -amp-start 8s steps(1, end) 0s 1 normal both;
        -moz-animation: -amp-start 8s steps(1, end) 0s 1 normal both;
        -ms-animation: -amp-start 8s steps(1, end) 0s 1 normal both;
        animation: -amp-start 8s steps(1, end) 0s 1 normal both;
      }
      @-webkit-keyframes -amp-start {
        from {
          visibility: hidden;
        }
        to {
          visibility: visible;
        }
      }
      @-moz-keyframes -amp-start {
        from {
          visibility: hidden;
        }
        to {
          visibility: visible;
        }
      }
      @-ms-keyframes -amp-start {
        from {
          visibility: hidden;
        }
        to {
          visibility: visible;
        }
      }
      @-o-keyframes -amp-start {
        from {
          visibility: hidden;
        }
        to {
          visibility: visible;
        }
      }
      @keyframes -amp-start {
        from {
          visibility: hidden;
        }
        to {
          visibility: visible;
        }
      }
</style>`;

const ampStyleAbc = `
<style amp-boilerplate>
    body {
        -webkit-animation: -amp-start 8s steps(1,end) 0s 1 normal both;
        -moz-animation: -amp-start 8s steps(1,end) 0s 1 normal both;
        -ms-animation: -amp-start 8s steps(1,end) 0s 1 normal both;
        animation: -amp-start 8s steps(1,end) 0s 1 normal both
      }
      @-webkit-keyframes -amp-start {
        from {visibility: hidden}
        to {visibility: visible}
      }
      @-moz-keyframes -amp-start {
        from {visibility: hidden}
        to {visibility: visible}
      }
      @-ms-keyframes -amp-start {
        from {visibility: hidden}
        to {visibility: visible}
      }
      @-o-keyframes -amp-start {
        from {visibility: hidden}
        to {visibility: visible}
      }
      @keyframes -amp-start {
        from {visibility: hidden}
        to {visibility: visible}
      }
  </style>  
<noscript>
      <style amp-boilerplate>
        body {
          -webkit-animation: none;
          -moz-animation: none;
          -ms-animation: none;
          animation: none;
        }
      </style>
    </noscript>`;
eventScriptGA4.vars.config[serverConfig.analytics.ga4TrackingId] =
  customDimension?.GA4CustomDimensions != null
    ? {
        ...customDimension?.GA4CustomDimensions,
        tg_ppid: cdpCookies?.tg_ppid || "",
        tg_uuid: cdpCookies?.tg_uuid || "",
      }
    : {};
---

<head>
  <meta charset="utf-8" />
  <title>AMP Page</title>
  <link rel="canonical" href="https://example.com/amp-page.html" />
  <meta
    name="viewport"
    content="width=device-width,minimum-scale=1,initial-scale=1"
  />
  <Fragment set:html={ampStyle} />
  <Fragment set:html={ampStyleAbc} />
  <!-- AMP runtime -->
  <script async src="https://cdn.ampproject.org/v0.js"></script>

  <body>
    <h1>Hello AMP!</h1>
  </body>
</head>
