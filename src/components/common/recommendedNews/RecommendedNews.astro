---
import style from "./RecommendedNews.module.scss";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import CustomSlideBox from "@components/common/wrappers/customSlideBox/CustomSlideBox.astro";
import HorizontalCard from "@components/common/widgets/horizontalCard/HorizontalCard.astro";
import { getNewImageUrl } from "src/utils/common";
import Link from "../link/Link.astro";
import TitleComponent from "@components/common/titleComponent/TitleComponent.astro";
const fetchTime = (item) => new Date(item.updatedate).toLocaleTimeString();
const { data } = Astro.props;
---

<div class={`${style["box"]}`}>
  <ContainerBox>
    <TitleComponent
      titleType={"h3"}
      moreButtonLink={"/mobile"}
      titleText={"Recommended News"}
      isWhiteLayout={false}
      arrowConfig={{ size: "", color: "" }}
      marginBottom={4}
      isSplitType={true}
    />
    <CustomSlideBox
      elementType={'ulBox'}
      gridGap={32}
      changeStyle={`${data?.length > 1 ? "width-100-50" : "singleItem"}`}
      marginBottom={0}
    >
      {
        data?.map((item, index) => {
          if (item.cmstype.toUpperCase() === "SECTION") return null;
          const time =
            item.cmstype === "MEDIAVIDEO" && item.media && fetchTime(item);

          return (
            <li class={style["list-items"]}>
              <HorizontalCard
                data={item}
                isWhiteLayout={false}
                isRowReverse={false}
                getUrlConfig={{
                  to: item?.seopath,
                  title: item?.title,
                }}
                imageConfig={{
                  style: "width-110x62",
                  inLineStyle: {},
                  imagePath: getNewImageUrl({
                    msid: item?.msid,
                    imgWidth: item?.imageWidth || 175,
                    imgHeight: item?.imageHeight || 85,
                  }),
                  imgWidth: item?.imageWidth || 175,
                  imgHeight: item?.imageHeight || 85,
                  time: time || "",
                }}
                titleConfig={{
                  style: "",
                  inLineStyle: {},
                  text: index + 1,
                  tag: "h6",
                }}
                paraConfig={{
                  style: "",
                  inLineStyle: { WebkitLineClamp: "3", lineHeight: "1.3" },
                  text: item.title || "",
                  tag: "p",
                }}
              />
            </li>
          );
        })
      }
    </CustomSlideBox>
  </ContainerBox>
</div>
