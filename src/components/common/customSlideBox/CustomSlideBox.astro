---
import style from "./CustomSlideBox.module.scss";
const {
  gridGap,
  marginTop,
  marginBottom,
  changeStyle,
  elementType = "divBox",
  inLineStyle,
  inLineChildStyle,
  isVerticalSlide,
} = Astro.props;
---

<div
  class={`${isVerticalSlide ? style["default-vertical"] : style["default"]} ${style[changeStyle]}`}
  style={{ ...inLineStyle }}
>
  {
    elementType === "divBox" && (
      <div
        class={`${style["overflow"]}`}
        style={{
          gap: `0 ${gridGap}px`,
          marginTop: `${marginTop}px`,
          marginBottom: `${marginBottom}px`,
          ...inLineChildStyle,
        }}
      >
        <slot />
      </div>
    )
  }
  {
    elementType === "ulBox" && (
      <ul
        class={`${style["overflow"]}`}
        style={{
          gap: `0 ${gridGap}px`,
          marginTop: `${marginTop}px`,
          marginBottom: `${marginBottom}px`,
          ...inLineChildStyle,
        }}
      >
        <slot />
      </ul>
    )
  }
</div>
