---
import style from "./RightArrow.module.scss";
import SvgIcon from "@components/common/svg/SvgIcon.astro";

const {
  arrowSize = "",
  arrowColor = "",
  isWhiteLayout = true,
  width = 24,
  height = 24,
} = Astro.props;

const iconName = isWhiteLayout ? "right-double-arrows" : "right-double-arrows-red";
---

<i class={`${style["arrow-icon"]} ${arrowSize && style[arrowSize]} ${arrowColor && style[arrowColor]}`}>
  <SvgIcon IconName={iconName} width={width} height={height} />
</i>