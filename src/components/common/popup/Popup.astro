---
import style from "./Popup.module.scss";

export interface Props {
  instanceId?: string;
  changeStyle?: string;
  ChangePopbody?: string;
  inLineStyle?: Record<string, string>;
  isDarkLayout?: boolean;
  isCloseButton?: boolean;
  isPopupSlideUp?: boolean;
  parentInLineStyle?: Record<string, string>;
}

const {
  instanceId = "default",
  changeStyle = "",
  ChangePopbody = "",
  inLineStyle = {},
  parentInLineStyle = {},
  isDarkLayout = false,
  isCloseButton = true,
  isPopupSlideUp = true
} = Astro.props;

// Unique IDs
const popupId = `popup_${instanceId}`;
const closeBtnId = `popupClose_${instanceId}`;
---

<div
  id={popupId}
  style={parentInLineStyle}
  class={`${style["popup-overlay"]} ${changeStyle ? style[changeStyle] : ""}`}
  data-instance={instanceId}
  data-open="false"
  aria-hidden="true"
>
  <div
    id={`popupContent_${instanceId}`}
    class={`${style["popup-content"]} ${
      isPopupSlideUp ? style["slide-up"] : style["slide-down"]
    }`}
    style={inLineStyle}
  >
    {isCloseButton && (
      <button id={closeBtnId} class={style["close-button"]}>×</button>
    )}
    <div class={`${style["popup-body"]} ${ChangePopbody ? style[ChangePopbody] : ""}`}>
      <slot />
    </div>
  </div>
</div>

<script define:vars={{ instanceId }}>
(function() {
  function initPopup() {
    if (window.PopupManager) {
      window.PopupManager.init(instanceId);
    } else {
      setTimeout(initPopup, 50);
    }
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPopup);
  } else {
    initPopup();
  }
})();
</script>
