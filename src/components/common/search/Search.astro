---
import style from "./Search.module.scss";
---

<div class={style.searchWrapper}>
    <div class={style.searchBox}>
        <input
            id="searchInput"
            type="text"
            placeholder="Search Stocks/IPOs, Mutual Funds, Articles..."
            autocomplete="off"
            aria-label="Search"
        />
        <button id="searchBtn" type="button">SEARCH</button>
    </div>

    <!-- note: we add both the hashed module class and a global class so JS & CSS both work -->
    <div
        id="resultsContainer"
        class={`${style.resultsContainer} results-container`}
        data-open="false"
        aria-hidden="true"
    >
    </div>
</div>

<script>
    // local dummy data (client-only)
    const searchData = {
        "Stocks/IPOs": [
            "Tata Chemicals Ltd",
            "Tata Communications Ltd",
            "Tata Consultancy Services Ltd",
            "Tata Consumer Products Ltd",
            "Tata Elxsi Ltd",
            "Tata Gold Exchange Traded Fund",
            "Tata Investment Corporation Ltd",
            "Tata Motors Ltd",
            "Tata Steel Ltd",
            "Tata Power Ltd",
        ],
        "Mutual Funds": [
            "Tata Aggressive Hybrid Fund - Regular (G)",
            "Tata Short Term Bond Fund - (G)",
            "Tata Equity PE Fund",
            "Tata Digital India Fund",
        ],
        Articles: [
            "Tata Capital IPO: BIG returns for World Bank Group's IFC",
            "Tata Technologies to acquire Germany’s ES-Tec Group",
            "Tata Capital IPO launch in October",
        ],
    };

    const input = document.getElementById("searchInput");
    const btn = document.getElementById("searchBtn");
    const resultsContainer = document.getElementById("resultsContainer");

    function setOpen(open) {
        resultsContainer.setAttribute("data-open", open ? "true" : "false");
        resultsContainer.setAttribute("aria-hidden", open ? "false" : "true");
    }

    function sanitizeText(s) {
        return String(s);
    }
    function renderResults(q) {
        const term = String(q || "")
            .trim()
            .toLowerCase();
        resultsContainer.innerHTML = "";

        if (!term) {
            setOpen(false);
            return;
        }

        let any = false;

        Object.keys(searchData).forEach((section) => {
            const matches = searchData?.[section].filter((item) =>
                item.toLowerCase().includes(term),
            );
            if (matches.length) {
                any = true;

                const sectionDiv = document.createElement("div");
                sectionDiv.className = "results-section";

                const h = document.createElement("h2");
                h.textContent = section;
                sectionDiv.appendChild(h);

                const ul = document.createElement("ul");
                matches.forEach((item) => {
                    const li = document.createElement("li");
                    li.className = "result-item";
                    li.tabIndex = 0;
                    li.dataset.value = sanitizeText(item);

                    const a = document.createElement("a");
                    a.href = "#";
                    a.textContent = item;

                    li.appendChild(a);
                    ul.appendChild(li);
                });

                sectionDiv.appendChild(ul);
                resultsContainer.appendChild(sectionDiv);
            }
        });

        if (any) {
            const footer = document.createElement("a");
            footer.className = "show-all";
            footer.tabIndex = 0;
            footer.href = "#";
            footer.textContent = "Show all result";
            resultsContainer.appendChild(footer);

            setOpen(true);
        } else {
            setOpen(false);
        }
    }

    function renderAll() {
        resultsContainer.innerHTML = "";
        Object.keys(searchData).forEach((section) => {
            const sectionDiv = document.createElement("div");
            sectionDiv.className = "results-section";

            const h = document.createElement("h3");
            h.textContent = section;
            sectionDiv.appendChild(h);

            const ul = document.createElement("ul");
            searchData?.[section].forEach((item) => {
                const li = document.createElement("li");
                li.className = "result-item";

                const a = document.createElement("a");
                a.href = "#";
                a.textContent = item;

                li.appendChild(a);
                ul.appendChild(li);
            });
            sectionDiv.appendChild(ul);
            resultsContainer.appendChild(sectionDiv);
        });

        const showAll = document.createElement("button");
        showAll.className = "show-all";
        showAll.type = "button";
        showAll.textContent = "Show All Results";

        resultsContainer.appendChild(showAll);
    }

    function debounce(fn, wait = 160) {
        let timer;
        return (...args) => {
            clearTimeout(timer);
            timer = setTimeout(() => fn(...args), wait);
        };
    }

    const onInput = debounce((e) => renderResults(e.target.value), 120);

    input.addEventListener("input", onInput);
    btn.addEventListener("click", () => renderResults(input.value));

    resultsContainer.addEventListener("click", (ev) => {
        const item = ev.target.closest(".result-item");
        if (item) {
            const v = item.dataset.value || item.textContent;
            input.value = v;
            setOpen(false);
            console.log("Selected:", v);
            return;
        }
        const foot = ev.target.closest(".show-all");
        if (foot) {
            renderAll();
        }
    });

    resultsContainer.addEventListener("keydown", (ev) => {
        if (ev.key === "Enter") {
            const item = ev.target.closest(".result-item");
            if (item) {
                input.value = item.dataset.value || item.textContent;
                setOpen(false);
                console.log("Selected (enter):", input.value);
            } else if (ev.target.classList.contains("show-all")) {
                renderAll();
            }
        }
    });
    document.addEventListener("click", (e) => {
        if (!resultsContainer.contains(e.target) && e.target !== input) {
            setOpen(false);
        }
    });
    
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
    });

    setOpen(false);
</script>
