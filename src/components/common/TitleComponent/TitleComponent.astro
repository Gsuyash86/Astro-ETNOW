---
import Typography from "@components/common/widgets/typography/Typography.astro";
import style from "./TitleComponent.module.scss";

const { title = "ET NOW", subtitle = "Insights" } = Astro.props;
---

<div class={style.titleWrapper}>
    <Typography
        tag={"p"}
        text={title}
        changeStyle={'font-size-34'}
        fontWeight={'700'}
        inLineStyle={inLineStyle}
    />
    <h2 class={style.title}>
        
        <em>{subtitle}</em>
        <span class={style.arrows}>&raquo;</span>
    </h2>
    <div class={style.line}></div>
</div>
