---
import style from './DateTime.module.scss';

const {
  changeStyle = '',
  inLineStyle = {},
  date = new Date()
} = Astro.props;

const className = `${style['date-time']} ${changeStyle && style[changeStyle] ? style[changeStyle] : ''}`;

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: '2-digit',
    year: 'numeric',
  });
}
---

<p class={className} style={inLineStyle}>
  {formatDate(date)}
</p>