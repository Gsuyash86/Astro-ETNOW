---
import MediaIcons from '@components/common/widgets/mediaIcons/MediaIcons.astro';
import DateTime from '@components/common/widgets/dateTime/DateTime.astro';
import Blinker from '@components/common/widgets/blinker/Blinker.astro';
import PremiumIcon from '@components/common/widgets/premiumIcon/PremiumIcon.astro';

import style from './typography.module.scss';

// Props
const {
  tag: Tag = 'p',
  text = '',
  changeStyle = 'default-paragraph',
  inLineStyle = {},
  isLineClamp = true,
  isWhiteLayout = false,
  data = {},
  time,
  mediaIconStyle,
  inLineMediaIconStyle,
  isShowCaptionOnImage = false,
  isWebStory = false,
  dateTime,
  isHighlightBlinker = false,
  isBlinker = false,
  isBlinkerText = true,
  isbBlinkerSmall = false,
  isBlinkerAnimation = true,
  isTextVisible = false,
  transparentBtn = false,
  inLineStyleBlinker,
  cmsType,
  inLineSpanStyle = false,
  textLimit,
  isFeaturedCard = false,
  isHorizontalCard = false,
  fontWeight = '400',
  isSecondFontFamily = false,
  isPremium = true
} = Astro.props;

const safeText = String(text).replace(/\s*style="[^"]*"/g, '');

const className = [
  changeStyle && style[changeStyle],
  !isLineClamp && style['no-line-clamp'],
  (isWhiteLayout || isShowCaptionOnImage) ? style['white'] : style['black'],
  fontWeight ? style[`font-weight-${fontWeight}`] : '',
  isSecondFontFamily ? style['second-font-family'] : '',
  style['default-paragraph']
].filter(Boolean).join(' ');
---

{(isShowCaptionOnImage || isFeaturedCard) && cmsType === 'LIVEBLOG' && (
  <Blinker isTextVisible={true} transparentBtn={false} />
)}

{isShowCaptionOnImage && (cmsType !== 'LIVEBLOG' || !isFeaturedCard) && (
  <MediaIcons
    mediaIconStyle={mediaIconStyle}
    inLineMediaIconStyle={inLineMediaIconStyle}
    data={data}
    time={time}
    isShowCaptionOnImage={isShowCaptionOnImage}
  />
)}

{cmsType !== 'LIVEBLOG' && isHighlightBlinker && (
  <Blinker
    isBlinker={isBlinker}
    isBlinkerText={isBlinkerText}
    isbBlinkerSmall={isbBlinkerSmall}
    isBlinkerAnimation={isBlinkerAnimation}
    isTextVisible={isTextVisible}
    transparentBtn={transparentBtn}
    inLineStyleBlinker={inLineStyleBlinker}
  />
)}

{cmsType === 'LIVEBLOG' ? (
  <Tag class={className} style={inLineStyle}>
    {isHorizontalCard && (
      <Blinker
        isBlinker={isBlinker}
        isBlinkerText={isBlinkerText}
        isbBlinkerSmall={isbBlinkerSmall}
        isBlinkerAnimation={isBlinkerAnimation}
        isTextVisible={isTextVisible}
        transparentBtn={transparentBtn}
        inLineStyleBlinker={inLineStyleBlinker}
      />
    )}
    <span set:html={safeText} />
  </Tag>
) : data?.primeid && isPremium ? (
  <Tag class={className} style={inLineStyle}>
    <PremiumIcon data={data} />
    <span set:html={safeText} />
  </Tag>
) : inLineMediaIconStyle?.display ? (
  <Tag class={className} style={inLineStyle}>
    <span style={inLineSpanStyle} set:html={safeText} />
  </Tag>
) : textLimit ? (
  <Tag class={className} style={inLineStyle}>
    {String(text)}
    <MediaIcons
      inLineMediaIconStyle={{
        position: 'relative',
        width: '14px',
        height: '14px',
        marginLeft: '5px',
        display: 'inline-block',
        paddingTop: '0',
      }}
      data={data}
      mediaIconStyle={'small-icon'}
    />
  </Tag>
) : (
  <Tag class={className} style={inLineStyle} set:html={safeText} />
)}

{isWebStory && <DateTime data={data} dateTime={dateTime} />}