---
import style from './PlayButton.module.scss';
import SvgIcon from '@components/common/svg/SvgIcon.astro';

const {
  layoutStyle = '',
  time = '',
} = Astro.props;
---

<>
  <SvgIcon IconName="video-player" />
  <i class={`${style['duration']} ${layoutStyle ? style[layoutStyle] : ''}`}>
    {time}
  </i>
</>