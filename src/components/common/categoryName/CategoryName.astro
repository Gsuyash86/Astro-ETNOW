---
import style from "./CategoryName.module.scss";
import WidgetParagraph from "../widgetParagraph/WidgetParagraph.astro";
const {
  changeStyle = "font-size-13",
  fontWeight = "700",
  inLineStyle = {},
  categoryName = "",
  redirectToUrl,
} = Astro.props;
---

{
  categoryName && (
    <a class={style.category} href={"/" + redirectToUrl || ""}>
      <WidgetParagraph
        tag={"p"}
        text={categoryName}
        changeStyle={changeStyle}
        fontWeight={fontWeight}
        isConditionalRendering={true}
        inLineStyle={inLineStyle}
      />
    </a>
  )
}
