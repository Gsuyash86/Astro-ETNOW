---
// Advertisement.astro
/**
 * @param {string} adCode - Ad code for the advertisement
 * @param {Array} size - Size array for the ad
 * @param {string} divId - Div ID where ad will be displayed
 * @param {Object} pageTarget - Targeting values like category, sub-category, pagetype, msid, article-index
 */
export interface Props {
  adCode: string;
  size: number[][];
  divId: string;
  pageTarget?: {
    section?: {
      category?: string;
      sub_category?: string;
    };
    page?: string;
    metaInfoAttr?: string;
    msid?: string;
    article_index?: string;
    cdp_audience?: string;
    customParams?: Record<string, any>;
    query?: Record<string, any>;
  };
  class?: string;
}

const { adCode, size, divId, pageTarget, class: className } = Astro.props;

// Generate unique ID for this instance
const uniqueId = `ad-${divId}-${Math.random().toString(36).substr(2, 9)}`;
---

<div id={divId} class={className} data-unique-id={uniqueId}></div>

<script define:vars={{ adCode, size, divId, pageTarget, uniqueId }}>
  // Wait for DOM to be ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeAd);
  } else {
    initializeAd();
  }

  function initializeAd() {
    // Check if this ad has already been initialized
    const adElement = document.querySelector(`[data-unique-id="${uniqueId}"]`);
    if (!adElement || adElement.dataset.initialized === "true") {
      return;
    }
    adElement.dataset.initialized = "true";

    let SlotArr = [],
      sec = pageTarget?.section?.category,
      subsec = pageTarget?.section?.sub_category,
      ptype = pageTarget?.page,
      metaInfoAttr = pageTarget?.metaInfoAttr,
      id = pageTarget?.msid,
      sequence = pageTarget?.article_index,
      cdp_audience = pageTarget?.cdp_audience,
      currentCustomParams = pageTarget?.customParams,
      query = pageTarget?.query && Object.values(pageTarget?.query)[0];

    // Initialize apstag if available
    if (window?.apstag) {
      window.apstag.init(APS_CONFIG);
    }

    let slotID = { slotID: divId, sizes: size, slotName: adCode };

    // Initialize googletag
    window.googletag = window.googletag || { cmd: [] };

    // Get PPID cookie
    const tg_ppid = window.getCookieValue
      ? window.getCookieValue("tg_ppid")
      : null;

    // Push to googletag command queue
    window.googletag.cmd.push(function () {
      // Define ad slot
      let ab = adCode?.includes("_ROS_Interstitial")
        ? window.googletag
            ?.defineOutOfPageSlot(
              adCode,
              window.googletag.enums.OutOfPageFormat.INTERSTITIAL
            )
            ?.addService(window.googletag.pubads())
        : window.googletag
            ?.defineSlot(adCode, size, divId)
            ?.addService(window.googletag.pubads());

      SlotArr.push(ab);

      // Clear and set targeting
      window.googletag.pubads().clearTargeting();

      if (sec) window.googletag.pubads().setTargeting("section", [sec]);
      if (subsec) window.googletag.pubads().setTargeting("subsec", [subsec]);
      if (ptype) window.googletag.pubads().setTargeting("page", [ptype]);
      if (metaInfoAttr)
        window.googletag.pubads().setTargeting("keyword", [metaInfoAttr]);
      if (id) window.googletag.pubads().setTargeting("articleid", [id]);
      if (sequence)
        window.googletag.pubads().setTargeting("article_sequence", [sequence]);
      if (query) window.googletag.pubads().setTargeting("demo", [query]);
      if (tg_ppid) window.googletag.pubads().setPublisherProvidedId(tg_ppid);
      if (cdp_audience)
        window.googletag.pubads().setTargeting("cdp_audience", [cdp_audience]);

      // Set custom params
      if (currentCustomParams && typeof currentCustomParams === "object") {
        Object.keys(currentCustomParams).forEach((key) => {
          window.googletag.pubads().setTargeting(key, currentCustomParams[key]);
        });
      } else if (currentCustomParams) {
        console.error(
          "Invalid currentCustomParams format:",
          currentCustomParams
        );
      }

      // Configure pubads
      window.googletag.pubads().setCentering(true);
      window.googletag.pubads().enableSingleRequest();
      window.googletag.pubads().enableAsyncRendering();
      window.googletag.pubads().setPrivacySettings({
        restrictDataProcessing: window.getCookieValue
          ? window.getCookieValue("privacy-policy") == 1
          : false,
      });

      window.googletag.pubads().disableInitialLoad();
      window.googletag.enableServices();
    });

    let isPubDone = false,
      isApsDone = false;

    window.googletag.cmd.push(function () {
      // Display the ad
      window.googletag.display(divId);

      // Fetch bids from apstag
      if (SlotArr && pubmaticOn && window.apstag) {
        window.apstag.fetchBids(
          { slots: [slotID] || [], timeout: BID_TIMEOUT },
          () => {
            isApsDone = true;
          }
        );
      } else {
        isApsDone = true;
      }

      // Request bids from PWT
      if (
        window?.PWT?.requestBids &&
        typeof window?.PWT?.requestBids === "function"
      ) {
        window.PWT.initAdserverSet = false;
        window.PWT.setAuctionTimeout(1000);
        window.PWT.requestBids(
          window.PWT.generateConfForGPT(SlotArr),
          function (adUnitsArray) {
            window.PWT.addKeyValuePairsToGPTSlots(adUnitsArray);
            isPubDone = true;
          }
        );
      } else {
        isPubDone = true;
      }

      // Refresh function to display ads after bidding
      let refresh = () => {
        if (isPubDone && isApsDone) {
          window.googletag.cmd.push(function () {
            if (window.apstag) {
              window.apstag.setDisplayBids();
            }
            window.googletag.pubads().refresh(SlotArr);
          });
        } else {
          setTimeout(refresh, 100);
        }
      };

      refresh();
    });

    // Store cleanup function for potential manual cleanup
    adElement._cleanupAd = function () {
      window.googletag.cmd.push(function () {
        window.googletag.destroySlots();
      });
    };
  }

  // Optional: Add cleanup on page navigation for SPAs
  document.addEventListener("astro:before-swap", () => {
    const adElement = document.querySelector(`[data-unique-id="${uniqueId}"]`);
    if (adElement && adElement._cleanupAd) {
      adElement._cleanupAd();
    }
  });
</script>

<style>
  /* Optional: Add any default styles for the ad container */
  div[id^="ad-"] {
    min-height: 50px;
    display: block;
  }
</style>
