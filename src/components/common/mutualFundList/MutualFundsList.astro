---
import style from "./MutualFundsList.module.scss";
import WidgetParagraph from "../widgetParagraph/WidgetParagraph.astro";
import CommonGridBox from "../commonGridBox/CommonGridBox.astro";
import MutualFundCard from "../mutualFundCard/MutualFundCard.astro";
const {
  changeStyle = "",
  inLineStyle = {},
  mFCategoriesLandingData,
} = Astro.props;
---

<div class={`${changeStyle && style[changeStyle]}`} style={{ ...inLineStyle }}>
  <h3>Mutual Funds</h3>

  <div class={`${style["filter"]}`}>
    <WidgetParagraph
      tag="p"
      text="Return period"
      changeStyle="font-size-14"
      fontWeight="400"
      isLineClamp={true}
      inLineStyle={{
        lineHeight: "1.2",
        color: "#878787",
        textTransform: "uppercase",
      }}
      isConditionalRendering={true}
    />
    <select class={`${style["select"]}`}>
      <option value="1">1Y</option>
      <option value="3">3Y</option>
      <option value="5">5Y</option>
    </select>
  </div>
  <WidgetParagraph
    tag="p"
    text="List of Best Funds in India sorted by Returns"
    changeStyle="font-size-12"
    fontWeight="400"
    isLineClamp={true}
    inLineStyle={{
      lineHeight: "1.2",
      color: "#68656B",
      marginBottom: "16px",
    }}
    isConditionalRendering={true}
  />
  <div class={`${style["top-trending-stock-box"]}`}>
    <CommonGridBox
      gridType="divGridBox"
      changeStyle={""}
      inLineStyle={{ marginBottom: "0px", gap: "24px" }}
    >
      {
        mFCategoriesLandingData?.map((item, index) => (
          <a href={`/${item?.seopath}`}>
            <MutualFundCard
              key={index}
              iconConfig={{
                iconUrl: item?.AMC_CODE,
              }}
              companyConfig={{
                tag: "p",
                text: item?.S_NAME,
                changeStyle: "font-size-16",
                fontWeight: "500",
                isLineClamp: true,
                inLineStyle: {
                  lineHeight: "1.375",
                  color: "#000000",
                },
              }}
              categoryConfig={{
                tag: "p",
                text: item?.mutualFundDetailsResponse?.category || "-",
                changeStyle: "font-size-14",
                fontWeight: "500",
                isLineClamp: true,
                inLineStyle: {
                  lineHeight: "1.2",
                  color: "#7C7E8C",
                },
              }}
              aum={item?.totalAUM}
              nav={item?.navRs}
              returns={{
                value:
                  typeof item?.Return === "number"
                    ? item.Return.toFixed(2)
                    : "--" + "%",
                isUp: item?.Return > 0,
              }}
              assetType={item?.mutualFundDetailsResponse?.assetType}
            />
          </a>
        ))
      }
    </CommonGridBox>
  </div>
  <div class={`${style["load-more"]}`}>
    <a href="/mutual-funds/mutual-fund-performance"> Show more </a>
  </div>
</div>
