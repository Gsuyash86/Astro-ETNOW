---
import style from "./MutualFundsList.module.scss";
import TitleComponent from "@components/common/titleComponent/TitleComponent.astro";
import Typography from "@components/common/widgets/typography/Typography.astro";
import CommonGridBox from "@components/common/wrappers/commonGridBox/CommonGridBox.astro";
import MutualFundCard from "../mutualFundCard/MutualFundCard.astro";
import Link from "@components/common/link/Link.astro";
import LoadMoreButton from "@components/common/loadMoreButton/LoadMoreButton.astro";
const {
  changeStyle = "",
  inLineStyle = {},
  mFCategoriesLandingData,
} = Astro.props;
---

<div
  className={`${changeStyle && style[changeStyle]}`}
  style={{ ...inLineStyle }}
>
  
  <TitleComponent
    type={"h3"}
    moreButtonLink={``}
    moreButtonText={"Mutual Funds"}
    fontSize={"font-size-24"}
    fontWeight={"700"}
    isSeprator={true}
    isDefaultFontFamily={false}
    changeStyle={""}
    inLineParentStyle={{ marginBottom: "16px" }}
  />

  <div className={`${style["filter"]}`}>
    <Typography
      tag="p"
      text="Return period"
      changeStyle="font-size-14"
      fontWeight="400"
      isLineClamp={true}
      inLineStyle={{
        lineHeight: "1.2",
        color: "#878787",
        textTransform: "uppercase",
      }}
    />
    <select className={`${style["select"]}`}>
      <option value="1">1Y</option>
      <option value="3">3Y</option>
      <option value="5">5Y</option>
    </select>
  </div>
  <Typography
    tag="p"
    text="List of Best Funds in India sorted by Returns"
    changeStyle="font-size-12"
    fontWeight="400"
    isLineClamp={true}
    inLineStyle={{
      lineHeight: "1.2",
      color: "#68656B",
      marginBottom: "16px",
    }}
  />
  <div className={`${style["top-trending-stock-box"]}`}>
    <CommonGridBox
      gridType="divGridBox"
      changeStyle={""}
      inLineStyle={{ marginBottom: "0px", gap: "24px" }}
    >
      {
        mFCategoriesLandingData?.map((item) => (
          <Link link={`/${item?.seopath}`}>
            <MutualFundCard
              iconConfig={{
                iconUrl: item?.AMC_CODE,
              }}
              companyConfig={{
                tag: "p",
                text: item?.S_NAME,
                changeStyle: "font-size-16",
                fontWeight: "500",
                isLineClamp: true,
                inLineStyle: {
                  lineHeight: "1.375",
                  color: "#000000",
                },
              }}
              categoryConfig={{
                tag: "p",
                text: item?.mutualFundDetailsResponse?.category || "-",
                changeStyle: "font-size-14",
                fontWeight: "500",
                isLineClamp: true,
                inLineStyle: {
                  lineHeight: "1.2",
                  color: "#7C7E8C",
                },
              }}
              aum={item?.totalAUM}
              nav={item?.navRs}
              returns={{
                value:
                  typeof item?.Return === "number"
                    ? item.Return.toFixed(2)
                    : "--" + "%",
                isUp: item?.Return > 0,
              }}
              assetType={item?.mutualFundDetailsResponse?.assetType}
            />
          </Link>
        ))
      }
    </CommonGridBox>
  </div>
  <div className={`${style["load-more"]}`}>
    <LoadMoreButton
      changeStyle={'red-button'}
      text={'Show more'}
      link={'/mutual-funds/mutual-fund-performance'}
        inLineStyle={{
          width: "145px",
          height: "39px",
          padding: "0px",
        }}
    />
  </div>
</div>
