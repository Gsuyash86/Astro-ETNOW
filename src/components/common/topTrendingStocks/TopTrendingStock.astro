---
import style from "./TopTrendingStock.module.scss";
import TitleComponent from "@components/common/titleComponent/TitleComponent.astro";
import CommonGridBox from "@components/common/wrappers/commonGridBox/CommonGridBox.astro";
import LogoCardList from "../LogoCardList/LogoCardList.astro";
import LoadMoreButton from "@components/common/loadMoreButton/LoadMoreButton.astro";
import { getDomain } from "@utils/common";
const { changeStyle = "", inLineStyle = {}, trendingStocks } = Astro.props;
---

<div class={`${changeStyle && style[changeStyle]}`} style={{ ...inLineStyle }}>

  <TitleComponent
    type={"h3"}
    moreButtonLink={``}
    moreButtonText={"Top Trending Stock"}
    fontSize={"font-size-24"}
    fontWeight={"700"}
    isSeprator={true}
    isDefaultFontFamily={false}
    changeStyle={""}
    inLineParentStyle={{ marginBottom: "16px" }}
  />

  <div class={`${style["top-trending-stock-box"]}`}>
    <CommonGridBox
      gridType="divGridBox"
      changeStyle={""}
      inLineStyle={{ marginBottom: "0px", gap: "24px" }}
    >
      {
        Array.isArray(trendingStocks) &&
          trendingStocks?.map((item, index) => (
            <LogoCardList
              key={index}
              href={`${getDomain()}/${item?.seopath}`}
              iconConfig={{
                iconUrl: item?.AMC_CODE,
                iconName: item?.S_NAME || "Stock",
              }}
              companyConfig={{
                tag: "p",
                text: item?.lname,
                changeStyle: "font-size-12",
                fontWeight: "bold",
                isLineClamp: true,
                inLineStyle: {
                  lineHeight: "1.2",
                  color: "#171725",
                },
              }}
              priceConfig={{
                tag: "p",
                text: item?.price,
                changeStyle: "font-size-14",
                fontWeight: "bold",
                isLineClamp: true,
                inLineStyle: {
                  lineHeight: "1.2",
                  color: "#171725",
                },
              }}
              marketButtonConfig={{
                isUp: item?.percchange > 0,
                change: item?.priceperchange
                  ? item.priceperchange.toFixed(2)
                  : "",
                change_percent: item?.percchange
                  ? item.percchange.toFixed(2) + "%"
                  : "",
              }}
            />
          ))
      }
    </CommonGridBox>
  </div>
  <div class={`${style["load-more"]}`}>
    <LoadMoreButton
      changeStyle={'red-button'}
      text={'Show more'}
      link={`${getDomain()}/stocks`}
        inLineStyle={{
          width: "145px",
          height: "39px",
          padding: "0px",
        }}
    />
  </div>
</div>
