---
import style from "./ContainerBox.module.scss";
const {
  changeStyle = "",
  noGutterSpace = false,
  inLineStyle = {},
  isWrap = true,
} = Astro.props;
---

{
  isWrap ? (
    <div
      class={`${style["container"]} ${changeStyle && style[changeStyle]}`}
      style={{ ...inLineStyle, padding: noGutterSpace ? "0" : "" }}
    >
      <slot />
    </div>
  ) : (
    <slot />
  )
}
