---
import { decodeHtml } from "@utils/common";

let {
  tag: Tag = "h2",
  style,
  changeStyle = "",
  titleText,
  children,
  moreButtonLink = "",
  isWhiteLayout = false,
  onClick = null,
  isLeftRedBorder = false,
  isSplitType=false
} = Astro.props;

const baseClass = `${style['default-title']} ${changeStyle && style[changeStyle]} ${
  isWhiteLayout ? style['white'] : style['black']
} ${isLeftRedBorder ? style['left-red-border'] : ''}`;

const splitType = isSplitType ? titleText?.split(" ")?.pop() : titleText;
titleText = titleText?.replace(splitType, '')?.trim();

---
{moreButtonLink ? (
  <a href={moreButtonLink} class={style['inline-block']} onclick={onClick}>
    <Tag class={baseClass}>
      {decodeHtml(titleText)}
     { isSplitType && <span style={{fontStyle:"italic"}}>{` ${decodeHtml(splitType)}`}</span>}
      <slot />
    </Tag>
  </a>
) : (
  <Tag class={baseClass}>
    {decodeHtml(titleText)}
    <slot />
  </Tag>
)}