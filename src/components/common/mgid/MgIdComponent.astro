---
const { scriptID, elementID, isAppView = false } = Astro.props;
const rootId = `M863117ScriptRootC${elementID}`;
const scriptSrc = `https://jsc.mgid.com/e/t/etnownews.com.${scriptID}.js`;
---

{
  !isAppView && (
    <div class="mgIDWrap">
      <div id={rootId}>
        <script is:inline src={scriptSrc} defer />
      </div>
    </div>
  )
}
