---
const { data } = Astro.props;
const htmlText = data.text;
if (!htmlText) return null;
---

<div class={`_z_subblogs mb-5`}>
  <div class={`_z_subblog_data`} data-embed-type={data.type}>
    <span class={`_z_subblog_dot dot-none`}></span>
    <p class={`_z_subblog_title f-s-14 mb-5`}>
      {data && data.title && data.title}
    </p>
    <div class="_z_media_embed">
      <div class="fb-embded" set:html={htmlText} />
    </div>
  </div>
</div>

<script>
  // Handle Instagram embeds
  function handleInstagramEmbeds() {
    if (typeof window.instgrm !== "undefined") {
      document.addEventListener(
        "scroll",
        () => {
          window.instgrm.Embeds.process();
        },
        { once: true }
      );
    }
  }

  // Handle Twitter embeds
  function handleTwitterEmbeds() {
    if (typeof window.twttr !== "undefined") {
      document.addEventListener(
        "scroll",
        () => {
          window.twttr.widgets.load();
        },
        { once: true }
      );
    }
  }

  // Load Twitter script
  function loadTwitterScript() {
    const existingScript = document.getElementById("twitterEmbed");
    if (!existingScript) {
      document.addEventListener(
        "scroll",
        function () {
          const script = document.createElement("script");
          script.setAttribute("defer", "true");
          script.setAttribute("id", "twitterEmbed");
          script.setAttribute("src", "https://platform.twitter.com/widgets.js");
          document.body.appendChild(script);
        },
        { once: true }
      );
    }
  }

  // Load Instagram script
  function loadInstagramScript() {
    const existingScript = document.getElementById("instagramEmbed");
    if (!existingScript) {
      document.addEventListener(
        "scroll",
        function () {
          const script = document.createElement("script");
          script.setAttribute("defer", "true");
          script.setAttribute("id", "instagramEmbed");
          script.setAttribute("src", "https://www.instagram.com/embed.js");
          document.body.appendChild(script);
        },
        { once: true }
      );
    }
  }

  // Initialize based on data type
  document.addEventListener("DOMContentLoaded", () => {
    const embedContainer = document.querySelector("._z_subblog_data");
    const embedType = embedContainer
      ?.getAttribute("data-embed-type")
      ?.toLowerCase();
    if (embedType === "twitter") {
      loadTwitterScript();
      handleTwitterEmbeds();
    } else if (embedType === "instagram") {
      loadInstagramScript();
      handleInstagramEmbeds();
    }
    handleInstagramEmbeds();
    handleTwitterEmbeds();
  });
</script>
