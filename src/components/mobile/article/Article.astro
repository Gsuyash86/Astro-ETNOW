---
import TitleComponent from "./TitleComponent.astro";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import CategoryName from "@components/common/widgets/categoryName/CategoryName.astro";
import AuthorDetailMobile from "./AuthorDetailMobile.astro";
import Synopsis from "./Synopsis.astro";
import KeyHighlight from "./KeyHighlight.astro";
import SocialWidgets from "@components/common/embeds/SocialWidgets.astro";
import TextLinkComponent from "./TextLinkComponent.astro";
import HtmlParagraph from "./HtmlParagraph.astro";
import RecommendedNews from "@components/common/recommendedNews/RecommendedNews.astro";
import AdCaller from "@components/common/adcaller/AdCaller.astro";
import CoverVDOAndImg from "./CoverVDOAndImg.astro";
import MgIdComponent from "@components/common/mgid/MgIdComponent.astro";
import VideoAiComponent from "@components/common/mgid/VideoAiComponent.astro";
import CONST from "src/constant";
import TopStockWidget from "@components/common/topTrendingStocks/TopStockWidget.astro";
import OneLiner from "@components/common/oneLiner/OneLiner.astro";
import KeywordTags from "@components/common/widgets/keywordTags/KeywordTags.astro";
import BreadCrumb from "@components/common/breadCrumb/BreadCrumb.astro";
import LatestNews from "@components/common/latestNews/LatestNews.astro";
import RelatedNews from "@components/common/relatedNews/RelatedNews.astro";
import TopVideos from "@components/common/topVideos/topVideos.astro";
import { getDomain } from "@utils/common";
import YoutubeEmbed from "@components/common/youtubeEmbed/YoutubeEmbed.astro";
import QuotesWidget from "@components/common/widgets/htmlQuotes/QuotesWidget.astro";
import MultiVideoPlayer from "@components/reactComponents/multiVideoPlayer/MultiVideoPlayer";
import {
  CATEGORY_TYPE_VIDEO_ARTICLE,
  DEFAULT_IMAGE_MSID,
} from "src/constant/index";
const { category, msid } = Astro.props;
const data = await fetch(
  `https://api.etnownews.com/request/articleshow/?origin=mobile&msid=${msid}&channel_id=382`
);
const response = await data.json();
const mainData = response?.response?.sections?.article_show?.data?.[0];
---

<ContainerBox inLineStyle={{ marginBottom: "7px" }}>
  <CategoryName
    categoryName={category?.split("-").join(" ") ||
      mainData?.categoryname ||
      ""}
    changeStyle={"font-size-12"}
    inLineStyle={{
      fontWeight: "600",
      color: "#696969",
      lineHeight: "1.2",
      textDecoration: "underline",
    }}
    redirectToUrl={`${getDomain()}/${category}`}
    title={category || mainData?.categoryname || ""}
  />
</ContainerBox>
<TitleComponent index={0} mainData={mainData} />

{
  mainData && (mainData.authors || mainData.updatedate || mainData.agency) ? (
    <AuthorDetailMobile
      byline={mainData?.Byline}
      updatedate={`${mainData?.updatedate}`}
      inLineStyle={{ marginBottom: "15px" }}
    />
  ) : null
}

<Synopsis text={mainData.synopsis} inLineStyle={{ marginBottom: "34px" }} />
<AdCaller {...response?.response?.ads?.atf} />
<KeyHighlight summary={mainData?.summary} />
<CoverVDOAndImg
  data={mainData?.cmsassoc || []}
  isMediaWireStory={mainData?.isMediaWireStory}
  mainData={mainData}
/>
{
  mainData?.embedData?.map((embedData, dataIndex) => (
    <Fragment>
      <SocialWidgets data={{ text: embedData?.twitterList, type: "twitter" }} />
      <SocialWidgets
        data={{ text: embedData?.instagramList, type: "instagram" }}
      />
      <SocialWidgets data={{ text: embedData?.fbList, type: "fb" }} />
      <SocialWidgets data={{ text: embedData?.reditList, type: "reddIt" }} />
      <SocialWidgets data={{ text: embedData?.iframeText, type: "iframe" }} />
      <TextLinkComponent
        htmlText={embedData.htmlText}
        iconType={embedData.iconType}
      />
      <YoutubeEmbed
        html_tag_attributes={embedData?.youtubeList}
        type={"WITH_THUMB"}
      />
      {embedData?.id ? (
        <MultiVideoPlayer
          data={{
            media: {
              id: embedData?.id,
              msid: "",
            },
          }}
          index={11}
          idx={11}
          articleLength={1}
          videoCount={1}
          channelTitle={msid || embedData?.title}
          categoryType={CATEGORY_TYPE_VIDEO_ARTICLE}
          thumbImg={embedData?.thumbUrl}
          msid={DEFAULT_IMAGE_MSID}
          style={{}}
          isMobile={true}
          client:load
        />
      ) : null}
      <QuotesWidget data={embedData.htmlQuote} />
      <RecommendedNews data={embedData?.embedArticle} />
      <RecommendedNews data={embedData?.photoType?.list} />
      <HtmlParagraph
        htmlText={
          embedData.htmlText
            ? embedData.htmlText
                .replace(/(<!\[CDATA\[)/gm, "")
                .replace(/(]]>)/gm, "")
            : ""
        }
        firstPara={embedData.paraLength == 1 && embedData?.ispara}
      />
      {embedData?.ad ? <AdCaller {...embedData?.ad} /> : null}
      {embedData.isMGIDShow ? (
        <MgIdComponent
          scriptID={CONST.MGID_ADD_1X1}
          elementID={CONST.MGID_ADD_1X1}
        />
      ) : null}
      {embedData?.isVDOAiShow ? <VideoAiComponent /> : null}
      {dataIndex == 1 ? (
        <RecommendedNews data={response?.response?.recommendedNews} />
      ) : null}
    </Fragment>
  ))
}
<KeywordTags data={mainData} />
<OneLiner />
<BreadCrumb isWrap={true} category="news" />
<TopStockWidget />
<RelatedNews data={mainData?.editorpicks} />
<TopVideos componentData={mainData?.rhs_widget} />
<LatestNews data={mainData?.latestSiblings} />
