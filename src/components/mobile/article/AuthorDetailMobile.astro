---
import style from "./AuthorDetailMobile.module.scss";
import ContainerBox from "@components/common/containerBox/ContainerBox.astro";
import WidgetParagraph from "@components/common/widgetParagraph/WidgetParagraph.astro";
const {
  changeStyle = "",
  inLineStyle = {},
  noGutterSpace = false,
  updatedate,
  byline,
} = Astro.props;
const formattedText = Object.entries(byline)
  .map(([key, arr]) => {
    const names = arr
      .map(
        (item) =>
          `<a href="/author/${item.seoname}-${item.id}" style="color: #292929;">${item.name}</a>`
      )
      .join(", ");
    return `${key}: ${names}`;
  })
  .join(`<span class="${style["author-separator"]}"></span>`);
---

<div
  class={`${style?.author ?? ""} ${
    changeStyle ? (style[changeStyle] ?? "") : ""
  }`}
  style={{ ...inLineStyle }}
>
  <ContainerBox noGutterSpace={noGutterSpace}>
    {
      formattedText?.length > 0 && (
        <WidgetParagraph
          tag="p"
          text={formattedText}
          isConditionalRendering={true}
          changeStyle={"font-size-12"}
          isLineClamp={false}
          isWhiteLayout={false}
          inLineStyle={{
            fontWeight: "400",
          }}
        />
      )
    }
    {
      updatedate && (
        <WidgetParagraph
          tag="p"
          text={"Updated "}
          isConditionalRendering={true}
          changeStyle={"font-size-12"}
          isLineClamp={false}
          isWhiteLayout={false}
          inLineStyle={{
            fontWeight: "400",
          }}
        />
      )
    }
  </ContainerBox>
</div>
