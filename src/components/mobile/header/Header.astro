---
import style from "./Header.module.scss";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import Link from "@components/common/link/Link.astro";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
import Navigation from "@components/mobile/navigation/Navigation.astro";
---

<header class={`${style["header"]}`}>
    <ContainerBox>
        <div class={`${style["header-top"]}`}>
            <div class={`${style["header-left"]}`}>
                <button class={`${style["header-hamburger"]}`}>
                    <SvgIcon
                        IconName={"hamburgerIcon"}
                        width={24}
                        height={24}
                    />
                </button>
                <Link link={"/"} className={`${style["header-logo"]}`}>
                    <img src="/assets/images/logo-large.svg" alt="ET Now" />
                </Link>
            </div>
            <div class={`${style["header-right"]}`}>
                <Link link={"/"} class={`${style["header-lang"]}`}>
                    <SvgIcon
                        IconName={"LanguageSwaitchIcon"}
                        width={20}
                        height={20}
                    />
                </Link>
                <button class={`${style["header-live-tv"]}`}>
                    <SvgIcon
                        IconName={"searchNewIconDesktop"}
                        width={20}
                        height={20}
                    />
                </button>
                <button class={`${style["header-live-tv"]}`}>
                    <SvgIcon
                        IconName={"livetvNewIconRed"}
                        width={26}
                        height={20}
                    />
                </button>
            </div>
        </div>
    </ContainerBox>
    <Navigation />
</header>
