                            />
                        </Link>
                    </div>
                    <div className={`${style["mutual-list"]}`}>
                        <Link
                            link={"/"}
                            className={`${style["mutual-link"]} ${style["mutual-invets-button"]}`}
                        >
                            <Typography
                                tag="span"
