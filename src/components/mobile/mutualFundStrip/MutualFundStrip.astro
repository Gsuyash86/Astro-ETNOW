                                tag="span"
                                text={`1 Year Return: <strong>6.04</strong>`}
                                changeStyle="font-size-12"
                                fontWeight=""
                                isLineClamp={false}
                                isWhiteLayout={false}
                                inLineStyle={{}}
                            />
                        </Link>
                    </div>
                    <div className={`${style["mutual-list"]}`}>
                        <Link link={"/"} className={`${style["mutual-link"]}`}>
                            <Typography
                                tag="span"
                                text={`1 Year Return: <strong>6.04</strong>`}
                                changeStyle="font-size-12"
                                fontWeight="700"
                                isLineClamp={false}
