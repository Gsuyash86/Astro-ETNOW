---
import style from "./TrendingStock.module.scss";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import CustomSlideBox from "@components/common/wrappers/customSlideBox/CustomSlideBox.astro";
import Link from "@components/common/link/Link.astro";
import Typography from "@components/common/widgets/typography/Typography.astro";
import SvgIcon from "@components/common/svg/SvgIcon.astro";

// Sample navItems array
const navItems = [
    {
        label: "Smart Nivesh",
        seopath:
            "https://www.timesnownews.com/initiatives/smart-nivesh-sahi-nivesh",
    },
    {
        label: "Latest",
        seopath: "https://www.etnownews.com/latest-news",
    },
    {
        label: "Market Overview",
        seopath: "https://www.etnownews.com/market-overview",
    },
    {
        label: "News",
        seopath: "https://www.etnownews.com/news",
    },
    {
        label: "Mutual Funds",
        seopath: "https://www.etnownews.com/mutual-funds",
    },
    {
        label: "Corporates",
        seopath: "https://www.etnownews.com/companies",
    },
    {
        label: "Money",
        seopath: "https://www.etnownews.com/personal-finance",
    },
    {
        label: "Crypto Now",
        seopath: "https://www.etnownews.com/cryptocurrency",
    },
    {
        label: "Economy",
        seopath: "https://www.etnownews.com/economy",
    },
    {
        label: "Luxe",
        seopath: "https://www.etnownews.com/et-now-luxe",
    },
    {
        label: "Sports",
        seopath: "https://www.etnownews.com/sports",
    },
];
---

<div class={`${style["trend"]}`}>
    <ContainerBox>
        <CustomSlideBox
            elementType="ulBox"
            gridGap={16}
            changeStyle=""
            marginTop={0}
            marginBottom={0}
            inLineStyle={{paddingTop: '3px', paddingBottom: '3px'}}
        >
            <li class={`${style['trend-sticky']}`}>
                <div className={`${style["trend-link"]} ${style["trend-icon"]}`}>
                    <SvgIcon IconName={'trendingStock'} width={10} height={13} />
                </div>
            </li>
            {
                navItems.map((item) => (
                    <li>
                        <Link
                            link={item.seopath}
                            className={`${style["trend-link"]}`}
                        >
                            <Typography
                                tag="span"
                                text={item.label}
                                changeStyle="font-size-14"
                                fontWeight="400"
                                isLineClamp={false}
                                isWhiteLayout={false}
                                inLineStyle={{ WebkitLineClamp: "1" }}
                            />
                        </Link>
                    </li>
                ))
            }
        </CustomSlideBox>
    </ContainerBox>
</div>
