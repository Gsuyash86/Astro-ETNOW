---
import Typography from "@components/common/widgets/typography/Typography.astro";
import Link from "@components/common/link/Link.astro";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
import style from "./Hamburger.module.scss";
import Search from "@components/common/search/Search.astro";
import { NAVIGATION_GROUPS } from "@utils/common";
const {
    hamburgerOpenId = "",
    hamburgerCloseId = "",
    inLineStyle = {},
} = Astro.props;

// Menu data structure
const menuData = NAVIGATION_GROUPS;
const { data } = Astro.props;
function groupMenuData(flatData) {
    const findByTitle = (title) =>
        flatData?.find((item) => item?.title === title);

    return NAVIGATION_GROUPS?.map((group) => ({
        section: group?.section,
        icon: group?.icon,
        items: group?.titles
            ?.map((title) => findByTitle(title))
            ?.filter(Boolean) // Remove undefined if title not found
            ?.map((item) => {
                if (item?.child) {
                    return {
                        ...item,
                        child: item?.child?.map((child) => ({ ...child })),
                    };
                }
                return item;
            }),
    }));
}

const groupedDataNavigation = groupMenuData(data);
---

<div class={style["box"]} id={hamburgerOpenId} style={{ ...inLineStyle }}>
    <div class={style["box-header"]}>
        <div class={style["box-top"]}>
            <button id={hamburgerCloseId}>
                <SvgIcon IconName={"CloseIconBig"} width={26} height={16} />
            </button>
            <Link link={""} className={style["live-tv"]}>
                <SvgIcon
                    IconName={"livetvNewIcon"}
                    width={26}
                    height={16}
                    inLineStyle={{ marginTop: "-2px" }}
                />
                <Typography
                    tag={"span"}
                    text={"Live TV"}
                    changeStyle={"font-size-12"}
                    fontWeight={"400"}
                    isLineClamp={false}
                    isWhiteLayout={true}
                    inLineStyle={{
                        WebkitLineClamp: "1",
                        lineHeight: "20px",
                        textTransform: "uppercase",
                    }}
                />
            </Link>
        </div>
        <div class={style["box-profile"]}>
            <Typography
                tag={"p"}
                text={"Welcome!"}
                changeStyle={"font-size-14"}
                fontWeight={"700"}
                isLineClamp={false}
                isWhiteLayout={false}
                inLineStyle={{
                    WebkitLineClamp: "1",
                    lineHeight: "14px",
                }}
            />
            <SvgIcon IconName={"userIcon"} width={26} height={26} />
        </div>
        <Search
            instanceId="hamburger"
            changeStyle="mobile-search"
            inLineStyle={{
                padding: "0px 15px 10px 15px",
                boxShadow: "none",
            }}
        />
    </div>
    <div class={style["box-body"]}>
        <nav class={style.navigation} id="hamburgerMenu">
            <ul class={style.mainMenu}>
                {
                    groupedDataNavigation?.map((category) => (
                        <li class={style.categoryItem}>
                            <div class={style.categoryHeader}>
                                <span
                                    class={style.categoryIcon}
                                    aria-hidden="true"
                                >
                                    <SvgIcon
                                        IconName={category.icon}
                                        width="17"
                                        height="17"
                                    />
                                </span>
                                <h3 class={style.categoryTitle}>
                                    {category.section}
                                </h3>
                            </div>
                            <ul class={style.subMenu}>
                                {category.items.map((item) => (
                                    <li class={style.subMenuItem}>
                                        <a
                                            href={item.seopath}
                                            class={style.subMenuLink}
                                        >
                                            {item.title}
                                        </a>
                                        {item?.child?.length > 0 && (
                                            <ul class={style.subMenu}>
                                                {item?.child?.map((child) => (
                                                    <li
                                                        class={
                                                            style.subMenuItem
                                                        }
                                                    >
                                                        <a
                                                            href={child.seopath}
                                                            class={
                                                                style.subMenuLink
                                                            }
                                                        >
                                                            {child.title}
                                                        </a>
                                                    </li>
                                                ))}
                                            </ul>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</div>
