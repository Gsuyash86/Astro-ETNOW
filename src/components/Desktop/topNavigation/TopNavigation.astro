---
import style from "./TopNavigation.module.scss";
import Typography from "@components/common/widgets/typography/Typography.astro";

const navLinks = [
  { href: "https://www.etnownews.com", title: "ET Now", isActive: true },
  { href: "https://www.timesnownews.com/", title: "Times Now", isActive: "" },
  { href: "https://www.timesnowhindi.com/", title: "Times Now Navbharat", isActive: "" },
  { href: "https://www.timesdrive.in/", title: "Times Drive", isActive: "" },
  { href: "https://advisor.etnownews.com", title: "ET Now Advisor", isActive: "" },
  { href: "https://www.unilist.in/", title: "UniList", isActive: "" },
  { href: "https://www.digit.in/", title: "Digit", isActive: "" },
  { href: "https://www.healthandme.com/", title: "Health and Me", isActive: "" },
  { href: "https://www.magicbricks.com/", title: "Magicbricks", isActive: "" },
  { href: "https://telugu.timesnownews.com/", title: "Telugu", isActive: "" },
  { href: "https://tamil.timesnownews.com/", title: "Tamil", isActive: "" },
  { href: "https://marathi.timesnownews.com/", title: "Marathi", isActive: "" },
  { href: "https://kannada.timesnownews.com/", title: "Kannada", isActive: "" },
  { href: "https://bengali.timesnownews.com/", title: "Bengali", isActive: "" },
  { href: "https://malayalam.timesnownews.com/", title: "Malayalam", isActive: "" },
  { href: "https://www.zoomtventertainment.com/", title: "Zoom", isActive: "" }
];


const {
  changeStyle = '',
  inLineStyle = {},
} = Astro.props;

---

<div style={{ overflow: 'hidden' }} id="topNavigationContainer">
  <ul class={`${style["nav-ul"]} ${changeStyle ? style[changeStyle] : ''}`} style={inLineStyle} id="topNavigation">
    {navLinks.map(({ href, title, isActive = false }) => (
      <li>
        <a href={href} title={title} target="_blank" class={`${style["nav-link"]} ${isActive ? style['nav-active'] : ''}`}>
          <Typography
            tag="span"
            text={title}
            changeStyle="font-size-12"
            fontWeight="400"
            isLineClamp={false}
            inLineStyle={{
              lineHeight: "1.2",
              letterSpacing: ".1em",
              whiteSpace: 'nowrap',
            }}
          />
        </a>
      </li>
    ))}
    <li id="topNavigationMoreButton" class={`more-link-button ${style["more-link-button"]}`} style={{ display: 'none' }} >
      <span class={`dot ${style["dot"]}`}>...</span>
    </li>
    <div class={`more-menu ${style["more-menu"]}`} id="topNavigationMoreMenu">
      <ul class={`more-menu-list ${style["more-menu-list"]}`} id="topNavigationMoreMenuList"></ul>
    </div>
  </ul>

</div>

<script define:vars={{ navLinks}} >
  document.addEventListener('DOMContentLoaded', function() {
    const topNavigation = document.getElementById('topNavigation');
    const moreButton = document.getElementById('topNavigationMoreButton');
    const moreMenu = document.getElementById('topNavigationMoreMenu');
    const moreMenuList = document.getElementById('topNavigationMoreMenuList');
    const navItems = topNavigation.querySelectorAll('li');

    function handleOverflow() {
      // Reset
      moreMenuList.innerHTML = '';
      moreMenu.style.display = 'none';
      moreButton.style.display = 'none';
      navItems.forEach(item => item.style.display = '');

      let totalWidth = topNavigation.offsetWidth;
      let usedWidth = 0;
      let overflowLinks = [];

      for (let i = 0; i < navItems.length; i++) {
        usedWidth += navItems[i].offsetWidth;
        if (usedWidth > totalWidth) {
          overflowLinks.push(navLinks[i]);
          navItems[i].style.display = 'none';
        }
      }

      if (overflowLinks.length > 0) {
        moreButton.style.display = 'block';
        // moreMenu.style.display = 'block';
        overflowLinks.forEach(link => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          const typographySpan = document.createElement('span');
          a.href = link?.href;
          a.title = link?.title;
          a.target = '_blank';
          a.classList.add('nav-link');

          typographySpan.textContent = link?.title;
          typographySpan.style.cssText = `
            font-size: 12px;
            font-weight: 400;
            line-height: 1.2;
            letter-spacing: .1em;
            white-space: nowrap;
          `;
          
          a.appendChild(typographySpan);
          li.appendChild(a);
          moreMenuList.appendChild(li);
        });
      }
      
      // Delete the nav items which are display none
      navItems.forEach((item, index) => {
        if (item.style.display === 'none') {
          navItems[index].remove();
        }
      });

    }

    handleOverflow();
    window.addEventListener('resize', handleOverflow);

    // Toggle more menu visibility
    moreButton.addEventListener('click', () => {
      moreMenu.style.display = moreMenu.style.display === 'block' ? 'none' : 'block';
    });

  });
</script>