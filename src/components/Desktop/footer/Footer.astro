<footer class={`${style["footer"]}`}>
    <ContainerBox>
        <Typography
            tag="h2"
            text={"About ET Now News"}
            changeStyle="font-size-16"
            fontWeight="700"
            isLineClamp={false}
            isWhiteLayout={true}
            inLineStyle={{
                marginBottom: "10px",
            }}
        />
        <div class={`${style["footer-description"]}`}>
            <Typography
                tag="p"
                text={`${aboutText} ${"&nbsp;"} ${readMore}`}
                changeStyle="font-size-12"
                fontWeight="400"
                isLineClamp={false}
                isWhiteLayout={true}
                inLineStyle={{
                    lineHeight: "20px",
                    color: "hsla(0,0%,100%,.75)",
                    marginBottom: "15px",
                }}
            />
        </div>

        <ul class={`${style["footer-social"]}`}>
            <li>
                <Typography
                    tag="p"
                    text={"Follow Us :"}
                    changeStyle="font-size-16"
                    fontWeight="700"
                    isLineClamp={false}
                    isWhiteLayout={true}
                    inLineStyle={{
                        lineHeight: "24px",
                    }}
                />
            </li>
            <li>
                <a href="#">
                    <SvgIcon IconName={"footerFbIcon"} width="22" height="22" />
                </a>
            </li>
            <li>
